PORT=3000
DATABASE_URL=postgresql://postgres:MAT_KHAU_PGADMIN@localhost:5432/thonhanh
JWT_SECRET=mot-chuoi-ngau-nhien-that-dai
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# --- Tuỳ chọn cho App Khách hàng ---
# Thời hạn đăng nhập trên app di động (mặc định 30d)
MOBILE_JWT_EXPIRES_IN=30d

# --- [Thành viên B] App Thợ + bộ điều phối ghép cặp (đều có mặc định, chỉ thêm khi cần đổi) ---
# Bản web của app chạy trên IP LAN: cho phép mọi origin khớp biểu thức này (ngoài CLIENT_ORIGIN)
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+)(:\d+)?$
# Địa chỉ công khai của API để ghép URL ảnh (trống = theo request). VD http://192.168.1.10:3000
# PUBLIC_BASE_URL=
# MEDIA_DIR=media
# DISPATCHER_ENABLED=true            # vòng điều phối chạy nền trong API (false: tắt)
# DISPATCHER_TICK_SECONDS=2
# LOCATION_MAX_AGE_MINUTES=10        # thợ mất GPS quá số phút này thì không được ghép (0 = bỏ kiểm tra)
# TRUST_COLD_START=0.5               # điểm tin cậy dùng khi ghép cho thợ mới chưa có đơn / đánh giá
# DISPATCH_MAX_WAIT_MINUTES=15       # đơn đặt ngay chờ tối đa rồi hệ thống huỷ
# COMMISSION_RATE=0.15
# WALLET_DEBT_LIMIT=500000
# MIN_WITHDRAWAL=50000
# WITHDRAWAL_AUTO_APPROVE=true       # demo: lệnh rút tiền được duyệt ngay
# SEED_DEMO=true                     # Docker: nạp dữ liệu demo khi khởi động
# Đăng nhập Google / Facebook (trống = ẩn nút trên app)
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Email quên mật khẩu (trống: mã in ra log + trả về app khi không phải production)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# PUSH_ENABLED=false
